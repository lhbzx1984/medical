+// 从现有种子源导入，固定 ID 保证重跑不重复，也不覆盖管理员已审核的修改。
+import { readFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { createClient } from "@supabase/supabase-js";
+import nextEnv from "@next/env";
+import ts from "typescript";
+
+export function readSeedEntries() {
+  const source = readFileSync(new URL("../src/lib/knowledge/seed.ts", import.meta.url), "utf8");
+  const compiled = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS } }).outputText;
+  const localModule = { exports: {} };
+  new Function("exports", "module", compiled)(localModule.exports, localModule);
+  return localModule.exports.SEED_KNOWLEDGE;
+}
+
+export async function seedKnowledge(client, entries = readSeedEntries()) {
+  const rows = entries.map((entry) => {
+    const bytes = createHash("sha256").update(`medplan-knowledge:${entry.title}`).digest().subarray(0, 16);
+    bytes[6] = (bytes[6] & 15) | 80;
+    bytes[8] = (bytes[8] & 63) | 128;
+    const hex = bytes.toString("hex");
+    const id = `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+    return { ...entry, id };
+  });
+  const { error } = await client.from("knowledge_entries").upsert(rows, { onConflict: "id", ignoreDuplicates: true });
+  if (error) throw new Error(`知识种子导入失败: ${error.message}`);
+  return rows.length;
+}
+
+if (process.argv[1] && pathToFileURL(process.argv[1]).href === import.meta.url) {
+  try {
+    nextEnv.loadEnvConfig(fileURLToPath(new URL("..", import.meta.url)));
+    const url = process.env.SUPABASE_URL || process.env.NEXT_PUBLIC_SUPABASE_URL;
+    const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
+    if (!url || !key) throw new Error("需要 SUPABASE_URL 与 SUPABASE_SERVICE_ROLE_KEY；先执行 supabase/schema.sql");
+    const count = await seedKnowledge(createClient(url, key, { auth: { persistSession: false } }));
+    console.log(`已处理 ${count} 条知识种子；已有相同 ID 的记录保持原样。`);
+  } catch (error) {
+    console.error(error instanceof Error ? error.message : "知识种子导入失败");
+    process.exitCode = 1;
+  }
+}
diff --git a/src/app/api/auth/route.ts b/src/app/api/auth/route.ts
--- /dev/null
+++ b/src/app/api/auth/route.ts
@@ -0,0 +1,43 @@
+import { authClient, authConfigured, authFailure, assertSameOrigin, requireActor, sessionCookie } from "@/lib/auth";
+import { apiError, ApiError } from "@/lib/http";
+import { readJson, textField } from "@/lib/validation";
+import { connection } from "next/server";
+
+export async function GET(req: Request) {
+  await connection();
+  if (!authConfigured()) return Response.json({ authenticated: false, configured: false });
+  try {
+    const actor = await requireActor(req);
+    return Response.json({ authenticated: true, configured: true, user: actor });
+  } catch (error) {
+    if (error instanceof ApiError && error.status === 401) {
+      return Response.json({ authenticated: false, configured: true });
+    }
+    return apiError(error);
+  }
+}
+
+export async function POST(req: Request) {
+  try {
+    assertSameOrigin(req);
+    const body = await readJson(req);
+    const email = textField(body, "email", 254);
+    const password = body.password;
+    if (typeof password !== "string" || !password.length || password.length > 200) {
+      throw new ApiError("请输入有效的密码", 400);
+    }
+    const { data, error } = await authClient(req.signal).auth.signInWithPassword({ email, password });
+    req.signal.throwIfAborted();
+    if (error || !data.session) throw authFailure(error, "登录失败，请核对账号和密码");
+    return Response.json({ authenticated: true }, {
+      headers: { "Set-Cookie": sessionCookie(data.session.access_token, data.session.expires_in) },
+    });
+  } catch (error) { return apiError(error); }
+}
+
+export async function DELETE(req: Request) {
+  try {
+    assertSameOrigin(req);
+    return Response.json({ authenticated: false }, { headers: { "Set-Cookie": sessionCookie("", 0) } });
+  } catch (error) { return apiError(error); }
+}
